<?xml version="1.0" encoding="utf-8"?>
<!--
   Auto Backup keeps the installation id and upload history, but NOT the Supabase credentials.
   The encrypted credential file can only be decrypted by the Android Keystore of the old device,
   so restoring it would break (and a plain copy must not be uploaded to the cloud backup).
-->
<full-backup-content>
    <exclude domain="sharedpref" path="supabase_secure_prefs.xml" />
    <exclude domain="sharedpref" path="supabase_config_prefs.xml" />
    <exclude domain="sharedpref" path="__androidx_security_crypto_encrypted_prefs__.xml" />
</full-backup-content>

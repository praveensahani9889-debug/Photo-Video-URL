{
  "rules": {
    "public_links": {
      "$id": {
        ".read": true,
        ".write": "!data.exists() || !newData.exists() || (newData.child('type').val() === data.child('type').val() && newData.child('supabaseUrl').val() === data.child('supabaseUrl').val() && newData.child('mimeType').val() === data.child('mimeType').val() && newData.child('body').val() === data.child('body').val() && (newData.child('views').val() === data.child('views').val() || newData.child('views').val() === (data.child('views').exists() ? data.child('views').val() : 0) + 1))",
        "views": {
          ".write": "data.parent().exists() && newData.isNumber() && newData.val() == (data.exists() ? data.val() : 0) + 1",
          ".validate": "newData.isNumber() && newData.val() >= 0"
        },
        "expiresAt": {
          ".validate": "newData.isNumber() && newData.val() > 0"
        },
        "maxViews": {
          ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 1000000"
        },
        "hasPassword": {
          ".validate": "newData.isBoolean()"
        },
        "passwordHash": {
          ".validate": "newData.isString() && newData.val().length == 64"
        },
        "passwordSalt": {
          ".validate": "newData.isString() && newData.val().length == 32"
        },
        "passwordIter": {
          ".validate": "newData.isNumber() && newData.val() >= 1000"
        },
        "bgColor": {
          ".validate": "newData.isString() && newData.val().matches(/^#[0-9A-Fa-f]{6}$/)"
        },
        "button": {
          "text": {
            ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 30"
          },
          "color": {
            ".validate": "newData.isString() && newData.val().matches(/^#[0-9A-Fa-f]{6}$/)"
          },
          "url": {
            ".validate": "newData.isString() && newData.val().matches(/^https?:[/][/].{1,490}$/)"
          }
        },
        "pageTitle": {
          ".validate": "newData.isString() && newData.val().length <= 60"
        },
        "pageMessage": {
          ".validate": "newData.isString() && newData.val().length <= 200"
        },
        "allowDownload": {
          ".validate": "newData.isBoolean()"
        },
        "topic": {
          ".validate": "newData.isString() && newData.val().length <= 80"
        },
        "body": {
          ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 5000"
        },
        "textColor": {
          ".validate": "newData.isString() && newData.val().matches(/^#[0-9A-Fa-f]{6}$/)"
        },
        "textBg": {
          ".validate": "newData.isString() && newData.val().matches(/^#[0-9A-Fa-f]{6}$/)"
        },
        "textFont": {
          ".validate": "newData.isString() && (newData.val() === 'sans' || newData.val() === 'serif' || newData.val() === 'mono' || newData.val() === 'cursive')"
        },
        "textSize": {
          ".validate": "newData.isNumber() && newData.val() >= 10 && newData.val() <= 48"
        },
        "textBold": {
          ".validate": "newData.isBoolean()"
        },
        "textItalic": {
          ".validate": "newData.isBoolean()"
        },
        "textUnderline": {
          ".validate": "newData.isBoolean()"
        },
        "textAlign": {
          ".validate": "newData.isString() && (newData.val() === 'left' || newData.val() === 'center' || newData.val() === 'right')"
        },
        "originalUrl": {
          ".validate": false
        },
        "url": {
          ".validate": false
        },
        "fileType": {
          ".validate": false
        },
        "mime": {
          ".validate": false
        },
        "supabaseUrl": {
          ".validate": "newData.isString() && newData.val().length <= 2048"
        },
        "fileName": {
          ".validate": "newData.isString() && newData.val().length <= 300"
        },
        "active": {
          ".validate": "newData.isBoolean()"
        }
      }
    },
    "photo_video_url": {
      "public_links": {
        "$id": {
          ".read": true
        }
      }
    },
    "user": {
      "$uid": {
        ".read": true,
        ".write": true
      }
    },
    "device_profiles": {
      "$key": {
        ".read": true,
        ".write": "!data.exists()"
      }
    },
    "ip_profiles": {
      "$key": {
        ".read": true,
        ".write": true
      }
    },
    "app": {
      ".read": true,
      ".write": false
    },
    "accounts": {
      "$id": {
        ".read": true,
        ".write": false
      }
    }
  }
}
{
  "rules": {
    "public_links": {
      "$id": {
        ".read": true,
        ".write": "!data.exists() || !newData.exists()"
      }
    },
    "photo_video_url": {
      "public_links": {
        "$id": {
          ".read": true
        }
      }
    },
    "user": {
      "$uid": {
        ".read": true,
        ".write": true
      }
    },
    "device_profiles": {
      "$key": {
        ".read": true,
        ".write": "!data.exists()"
      }
    },
    "ip_profiles": {
      "$key": {
        ".read": true,
        ".write": true
      }
    },
    "app": {
      ".read": true,
      ".write": false
    }
  }
}
